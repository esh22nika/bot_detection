{
  "dataset_name": "BotDriftBench",
  "version": "0.2.0",
  "description": "A controlled, reproducible benchmark for evaluating social-bot detection under parameterized behavioral shifts. Feature distributions are empirically calibrated from Cresci-2017 (14,368 accounts, 6.6M tweets). Each account is a longitudinal trajectory with Markov state carry-forward.",
  "generated_at": "2026-09-14T00:59:35.142034",
  "parameters": {
    "seed": 42,
    "n_accounts": 1000,
    "n_time_windows": 20,
    "drift_magnitude": 1.0,
    "tau_start": 5,
    "tau_end": 15
  },
  "statistics": {
    "n_total_observations": 20000,
    "n_human_accounts": 500,
    "n_bot_accounts": 500,
    "n_features": 30
  },
  "mathematical_framework": {
    "evolution_model": "X_{i,j,t} = X_{i,j,t-1} + trend_j + noise_{i,j,t}",
    "drift_model": "X_{i,j,t} = X_{i,j,t-1} + trend_j + delta_{s,j} * magnitude * per_step + noise_{i,j,t}",
    "noise_distribution": "N(0, sigma_{natural,j})",
    "drift_magnitude_param": 1.0,
    "change_point_tau_start": 5,
    "change_point_tau_end": 15
  },
  "temporal_coverage": {
    "start_date": "2023-01-01",
    "end_date": "2024-07-24",
